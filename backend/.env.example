# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
# Local development — keep this for local dev:
MONGO_URI=mongodb://127.0.0.1:27017/lucky_couture
# Production (Render) — set this as an environment variable in the Render dashboard:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Admin bootstrap (used only by the seed script)
ADMIN_NAME=Lucky Couture Admin
ADMIN_EMAIL=admin@luckycouture.in
ADMIN_PASSWORD=change_this_password

# Cloudinary (optional — falls back to local /uploads storage when unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Services
# Option 1: Resend HTTPS API (Recommended for Render - no SMTP port restrictions)
RESEND_API_KEY=
# Option 2: Standard SMTP (for environments where outbound SMTP ports 465/587 are open)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Sender Name & Email
EMAIL_FROM="Lucky Couture <onboarding@resend.dev>"

# Business rules (defaults; overridable via Admin Settings API)
DEFAULT_DAILY_TAILORING_CAPACITY=4
DEFAULT_DAILY_PRIORITY_CAPACITY=2
DEFAULT_PRIORITY_SURCHARGE_MIN=40
DEFAULT_PRIORITY_SURCHARGE_MAX=50

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# Twilio Verify Service Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

